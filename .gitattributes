# Treat PDFs as binary; never line-ending convert
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff2 binary
*.zip binary

# Normalize text
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.astro text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
