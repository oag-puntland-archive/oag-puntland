---
import Base from "@/layouts/Base.astro";
import { t, LOCALES, type Locale } from "@/i18n/strings";
import reports from "@/data/reports.json";
import legislation from "@/data/legislation.json";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const reportCount = reports.length;
const legCount = legislation.length;
const auditRelevantCount = legislation.filter((s: any) => s.role === "audit-relevant").length;
---

<Base lang={lang} title={t("home_h1", lang)} section="home">
  <article class="prose">
    <h1>{t("home_h1", lang)}</h1>
    <p>{t("home_lede", lang)}</p>

    <div class="callout info">
      <h3>{t("home_primary_links", lang)}</h3>
      <ul style="margin-bottom:0;">
        <li><a href={`/${lang}/reports/`}>{t("nav_reports", lang)}</a> — {reportCount}</li>
        <li><a href={`/${lang}/legislation/`}>{t("nav_legislation", lang)}</a> — {legCount} ({auditRelevantCount} audit-relevant)</li>
        <li><a href={`/${lang}/standards/`}>{t("nav_standards", lang)}</a></li>
        <li><a href={`/${lang}/source-safety/`}>{t("nav_source_safety", lang)}</a></li>
        <li><a href={`/${lang}/custody/`}>{t("nav_custody", lang)}</a></li>
      </ul>
    </div>

    <h2>{t("home_what_v1_does", lang)}</h2>
    <p>{t("home_what_v1_does_body", lang)}</p>

    <h2>{t("home_what_v1_does_not_do", lang)}</h2>
    <p>{t("home_what_v1_does_not_do_body", lang)}</p>
  </article>
</Base>
