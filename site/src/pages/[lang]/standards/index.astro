---
import Base from "@/layouts/Base.astro";
import { t, LOCALES, type Locale } from "@/i18n/strings";
export function getStaticPaths() { return LOCALES.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Locale;
---
<Base lang={lang} title={t("standards_h1", lang)} section="standards" pathInLang="standards">
  <article class="prose">
    <h1>{t("standards_h1", lang)}</h1>
    <p>{t("standards_intro", lang)}</p>
    <div class="callout"><p style="margin: 0;">{t("standards_disclaimer", lang)}</p></div>

    <h2>{t("standards_issai_h", lang)}</h2>
    <p>{t("standards_issai_body", lang)}</p>

    <h2>{t("standards_saipmf_h", lang)}</h2>
    <p>{t("standards_saipmf_body", lang)}</p>

    <h2>{t("standards_issai12_h", lang)}</h2>
    <p>{t("standards_issai12_body", lang)}</p>
  </article>
</Base>
