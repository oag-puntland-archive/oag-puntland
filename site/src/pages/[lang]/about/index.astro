---
import Base from "@/layouts/Base.astro";
import { t, LOCALES, type Locale } from "@/i18n/strings";
export function getStaticPaths() { return LOCALES.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Locale;
---
<Base lang={lang} title={t("about_h1", lang)} section="about" pathInLang="about">
  <article class="prose">
    <h1>{t("about_h1", lang)}</h1>
    <h2>{t("about_h_founded", lang)}</h2>
    <p>{t("about_founded_body", lang)}</p>
    <h2>{t("about_h_mandate", lang)}</h2>
    <p>{t("about_mandate_body", lang)}</p>
    <h2>{t("about_h_leadership", lang)}</h2>
    <p>{t("about_leadership_body", lang)}</p>
  </article>
</Base>
