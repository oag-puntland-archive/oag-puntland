---
import Base from "@/layouts/Base.astro";
import { t, LOCALES, type Locale } from "@/i18n/strings";
export function getStaticPaths() { return LOCALES.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Locale;
---
<Base lang={lang} title={t("methodology_h1", lang)} section="methodology" pathInLang="methodology">
  <article class="prose">
    <h1>{t("methodology_h1", lang)}</h1>
    <p>{t("methodology_intro", lang)}</p>

    <h2>{t("methodology_financial", lang)}</h2>
    <p>{t("methodology_financial_body", lang)}</p>

    <h2>{t("methodology_compliance", lang)}</h2>
    <p>{t("methodology_compliance_body", lang)}</p>

    <h2>{t("methodology_performance", lang)}</h2>
    <p>{t("methodology_performance_body", lang)}</p>

    <h2>{t("methodology_forensic", lang)}</h2>
    <p>{t("methodology_forensic_body", lang)}</p>

    <h2>{t("methodology_donor", lang)}</h2>
    <p>{t("methodology_donor_body", lang)}</p>
  </article>
</Base>
