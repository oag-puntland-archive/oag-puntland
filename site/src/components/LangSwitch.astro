---
import { LOCALES, LOCALE_LABEL, type Locale } from "@/i18n/strings";

interface Props {
  lang: Locale;
  otherUrl: string;
}
const { lang, otherUrl } = Astro.props;
---

<div class="lang-switch" role="group" aria-label="Language switcher">
  {LOCALES.map((l) => (
    <a
      href={l === lang ? `/${l}/` : otherUrl}
      aria-current={l === lang ? "true" : undefined}
      hreflang={l}
      lang={l}
    >
      {LOCALE_LABEL[l]}
    </a>
  ))}
</div>
